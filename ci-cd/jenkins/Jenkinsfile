pipeline {
    agent any

    environment {
        AWS_REGION = "ap-northeast-1"
        ECR_REPO = "578109960340.dkr.ecr.ap-northeast-1.amazonaws.com/enterprise-task-platform"
        IMAGE_TAG = "latest"
        CONTAINER_NAME = "task-platform"
        EC2_HOST = "52.195.19.156"
        SSH_USER = "ubuntu"
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        stage('Checkout Code') {
            steps {
                cleanWs()
                git branch: 'main',
                    url: 'https://github.com/fred2030/enterprise-task-platform.git'
            }
        }

        stage('Build Application') {
            steps {
                sh '''
                cd app
                chmod +x mvnw
                ./mvnw clean package -DskipTests
                '''
            }
        }

       stage('Test Docker') {
           steps {
        sh 'docker ps'
    }
}
        stage('Build Docker Image') {
            steps {
                sh '''
               docker build -t 578109960340.dkr.ecr.ap-northeast-1.amazonaws.com/enterprise-task-platform:latest -f app/Dockerfile app
                '''
            }
        }

        stage('Login to AWS ECR') {
    steps {
        sh '''
        aws ecr get-login-password --region ap-northeast-1 | \
        docker login --username AWS --password-stdin 578109960340.dkr.ecr.ap-northeast-1.amazonaws.com
        '''
    }
}

        stage('Push Image to ECR') {
            steps {
                sh '''
                docker push $ECR_REPO:$IMAGE_TAG
                '''
            }
        }

        stage('Deploy to EC2') {
    steps {
        sshagent(['ec2-key']) {
            sh '''
            ssh -o StrictHostKeyChecking=no ubuntu@52.195.19.156 << EOF
            docker pull 578109960340.dkr.ecr.ap-northeast-1.amazonaws.com/enterprise-task-platform:latest
            docker stop task-platform || true
            docker rm task-platform || true
            docker run -d -p 8080:8080 --name task-platform 578109960340.dkr.ecr.ap-northeast-1.amazonaws.com/enterprise-task-platform:latest
            EOF
            '''
        }
    }
}

    post {
        success {
            echo "✅ Deployment SUCCESS via ECR"
        }
        failure {
            echo "❌ Deployment FAILED"
        }
    }
}
